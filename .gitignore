# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# aios
.aios-core/node_modules

# database
data/*.db
data/*.db-wal
data/*.db-shm

# typescript
*.tsbuildinfo
next-env.d.ts

# large doc assets (images, original manuscripts)
docs/imagens/
docs/original/*.rtf
docs/original/*.docx
docs/revisado/*.docx
